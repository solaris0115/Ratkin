# Cursor 인덱싱에서 제외할 파일들

# RimWorld 세이브 파일은 항상 포함
!*.rws

# 워크플로우 추적 파일들
# workflow/
# WorkFlow/

# 워크플로우 아카이브 폴더는 Cursor 인덱싱에서 제외
WorkflowArchive/

# Git 관련 파일들
.git/

# 빌드 결과물들
Project/*/Source/bin/
Project/*/Source/obj/
Project/*/Source/.vs/

# 1.5 폴더 - Assemblies, Languages만 제외 (Source, Defs, Patches는 포함)
Project/1.5/Assemblies/
Project/1.5/Languages/
# 1.5 내 Source, Defs, Patches 3개만 인덱싱에 포함
!Project/1.5/Source/
!Project/1.5/Defs/
!Project/1.5/Patches/

# 임시 파일들
*.tmp
*.temp
*~

# 로그 파일들
*.log

# IDE 설정 파일들 (필요시 추가)
.idea/
