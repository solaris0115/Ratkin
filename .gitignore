# Ratkin 프로젝트 .gitignore
# 필요한 파일들만 무시하는 방식

# 유니크 폰 기획/메모 (로컬 작업용)
20_UniquePawn/

# 림월드 참조 데이터/소스 (로컬 심볼릭 링크 또는 폴더)
RimworldData/
RimworldSource/
AlienRace/

# C# 프로젝트 빌드 출력 폴더
obj/
bin/

# Visual Studio 관련 파일들
*.user
*.suo
*.cache
*.pdb
*.exe

# 임시 파일들
*.tmp
*.temp
*~
.DS_Store
Thumbs.db

# 로그 파일들
*.log

# 백업 파일들
*.bak
*.backup

# 압축 파일들
*.zip
*.rar
*.7z

# IDE 설정 파일들 (워크스페이스 빌드 태스크는 공유)
.vscode/*
!.vscode/tasks.json
.idea/
*.swp
*.swo

# Node.js 관련 (만약 사용한다면)
node_modules/
npm-debug.log*

# Python 관련 (만약 사용한다면)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
*.dtmp
