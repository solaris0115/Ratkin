# Ratkin 프로젝트 .gitignore
# 필요한 파일들만 무시하는 방식

# 림월드 참조 데이터/소스 (로컬 심볼릭 링크 또는 폴더)
#RimworldData/
#RimworldSource/

# C# 프로젝트 빌드 출력 폴더
obj/
bin/

# Visual Studio 관련 파일들
*.user
*.suo
*.cache
*.pdb
*.exe
*.dll

# 임시 파일들
*.tmp
*.temp
*~
.DS_Store
Thumbs.db

# 로그 파일들
*.log

# 백업 파일들
*.bak
*.backup

# 압축 파일들
*.zip
*.rar
*.7z

# Def 데이터 캐시 (AI 작업용, 로컬 전용)
.cursor/def-cache/

# IDE 설정 파일들 (Cursor 제외)
.vscode/
.idea/
*.swp
*.swo

# Node.js 관련 (만약 사용한다면)
node_modules/
npm-debug.log*

# Python 관련 (만약 사용한다면)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
*.dtmp
