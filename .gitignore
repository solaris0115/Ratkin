# Ratkin 프로젝트 .gitignore
# Project/ 폴더만 트래킹하고 나머지는 무시

# 모든 파일과 폴더를 기본적으로 무시
/*

# Project/ 폴더만 트래킹 (모든 하위 폴더와 파일 포함)
!/Project/
!/Project/**/*

# 워크플로우 추적 파일들은 기본적으로 무시 (필요시 수동 추가)
!/workflow/
!/workflow/**
!/WorkFlow/
!/WorkFlow/**

# 워크플로우 아카이브 폴더는 Git에서 추적
!/WorkflowArchive/
!/WorkflowArchive/**

# Dependencies 폴더는 Git에서 추적 (의존성 분석 결과)
!/Dependencies/
!/Dependencies/**

# Cursor Rules 폴더는 Git에서 추적
!/.cursor/
!/.cursor/**

# .gitignore 파일 자체도 트래킹
!.gitignore

# 루트 디렉토리의 중요한 파일들 트래킹
!defnames_typed.txt
!resource_names_typed.txt
!extract_defnames.py
!extract_resource_names.py
!DefDependencyInfo/
!DefDependencyInfo/**

# C# 프로젝트 빌드 출력 폴더 제외
obj/
bin/