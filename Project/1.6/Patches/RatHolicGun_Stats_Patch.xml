<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- RangedCooldownFactor에 RatHolic Gun Spooling StatPart 추가 -->
  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <!-- parts가 없으면 생성 -->
      <li Class="PatchOperationTest">
        <success>Invert</success>
        <xpath>*/StatDef[defName = "RangedCooldownFactor"]/parts</xpath>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>*/StatDef[defName = "RangedCooldownFactor"]</xpath>
        <value>
          <parts>
          </parts>
        </value>
      </li>
      <!-- parts에 StatPart 추가 -->
      <li Class="PatchOperationAdd">
        <xpath>*/StatDef[defName = "RangedCooldownFactor"]/parts</xpath>
        <value>
          <li Class="NewRatkin.StatPart_RatHolicGunSpooling">
            <!-- RK_Stat_RangeCoolDown 스탯 값을 자동으로 가져와서 사용 -->
          </li>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>