<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- leaderRole=true인 모든 지도자형 역할에 랫킨 의류 통일 적용 (바닐라+모드 추가 역할 자동 포함) -->
	<Operation Class="PatchOperationAdd">
		<xpath>*/PreceptDef[leaderRole = 'true']/roleApparelRequirements</xpath>
		<value>
			<!-- 랫킨 왕관 -->
			<li>
				<requirement>
					<bodyPartGroupsMatchAny>
						<li>UpperHead</li>
					</bodyPartGroupsMatchAny>
					<requiredDefs>
						<li>RK_RoyalCrown</li>
					</requiredDefs>
				</requirement>
			</li>
			<!-- 랫킨 로열 외투 -->
			<li>
				<requirement>
					<bodyPartGroupsMatchAny>
						<li>Torso</li>
						<li>Neck</li>
						<li>Shoulders</li>
						<li>Arms</li>
						<li>Legs</li>
					</bodyPartGroupsMatchAny>
					<requiredDefs>
						<li>RK_RoyalRobe</li>
					</requiredDefs>
				</requirement>
			</li>
			<!-- 랫킨 수녀복 -->
			<li>
				<requirement>
					<bodyPartGroupsMatchAny>
						<li>Torso</li>
						<li>Neck</li>
						<li>Shoulders</li>
						<li>Arms</li>
						<li>Legs</li>
					</bodyPartGroupsMatchAny>
					<requiredDefs>
						<li>RK_SistersDerss</li>
					</requiredDefs>
				</requirement>
			</li>
			<!-- 랫킨 수녀 베일 -->
			<li>
				<requirement>
					<bodyPartGroupsMatchAny>
						<li>UpperHead</li>
					</bodyPartGroupsMatchAny>
					<requiredDefs>
						<li>RK_SistersVeil</li>
					</requiredDefs>
				</requirement>
			</li>
			<!-- 랫킨 화이트 코트 -->
			<li>
				<requirement>
					<bodyPartGroupsMatchAny>
						<li>Torso</li>
						<li>Neck</li>
						<li>Shoulders</li>
						<li>Arms</li>
						<li>Legs</li>
					</bodyPartGroupsMatchAny>
					<requiredDefs>
						<li>RK_WhiteCoat</li>
					</requiredDefs>
				</requirement>
			</li>
		</value>
	</Operation>
</Patch>
