<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- 바닐라 Human 바디의 FullHead 부위들에 RK_BodyGroup_FullHead 그룹 추가 -->
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- Head -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Skull -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Skull"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Brain -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Skull"]/parts/li[def="Brain"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Left Eye -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Eye"][customLabel="left eye"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Right Eye -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Eye"][customLabel="right eye"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Left Ear -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Ear"][customLabel="left ear"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Right Ear -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Ear"][customLabel="right ear"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Nose -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Nose"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Jaw -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Jaw"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
			<!-- Tongue -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/BodyDef[defName="Human"]/corePart/parts/li/parts/li[def="Head"]/parts/li[def="Jaw"]/parts/li[def="Tongue"]/groups</xpath>
				<value><li>RK_BodyGroup_FullHead</li></value>
			</li>
		</operations>
	</Operation>
</Patch>
