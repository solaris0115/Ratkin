<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 랫킨 기도회, 수녀만 가능, 무드를 올려줌  -->
	<AbilityDef Name="Speech">
		<defName>RK_PrayerService</defName>
		<label>prayer service</label>
		<description>hosting prayer service that makes people calm and peaceful.</description>
		<iconPath>UI/Abilities/PrayerService</iconPath>
		<hotKey>Misc12</hotKey>
		<gizmoClass>NewRatkin.Command_AbilityPrayService</gizmoClass>
		<displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted>
		<disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
		<cooldownTicksRange>180000~300000</cooldownTicksRange>
		<targetRequired>False</targetRequired>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<range>-1</range>
		</verbProperties>
		<comps>
			<li Class="NewRatkin.CompProperties_AbilityPrayService"/>
		</comps>
	</AbilityDef>

	<!-- 증강용 기능에 대해서는 중복 불가. 밸런싱 목적 -->
	<AbilityGroupDef>
		<defName>RK_AbilityGroup_MoraleBoost</defName>
		<cooldownTicks>60000</cooldownTicks>
	</AbilityGroupDef>

	<AbilityDef ParentName="RoleAuraBuffBase">
		<defName>RK_Ability_MeleeMoraleBooster</defName>
		<label>morale booster</label>
		<description>Boost the morale of everyone nearby.</description>
		<iconPath>UI/Abilities/RK_TextureIcon_Banner</iconPath>
		<warmupMoteSocialSymbol>UI/Abilities/MarksmanCommand</warmupMoteSocialSymbol>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<groupDef>RK_AbilityGroup_MoraleBoost</groupDef>		<!--overrides MultiRole-->
		<comps>
			<li Class="CompProperties_AbilityGiveHediff">
				<compClass>CompAbilityEffect_GiveHediff</compClass>
				<hediffDef>RK_Hediff_MoraleBooster</hediffDef>
				<onlyBrain>True</onlyBrain>
				<onlyApplyToSelf>True</onlyApplyToSelf>
				<replaceExisting>true</replaceExisting>
			</li>
		</comps>
	</AbilityDef>
</Defs>