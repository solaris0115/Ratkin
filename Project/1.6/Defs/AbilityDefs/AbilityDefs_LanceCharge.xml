<?xml version="1.0" encoding="utf-8"?>
<!-- LanceCharge Ability RK_Ability_LanceCharge RK_PawnFlyer_LanceCharge RK_Hediff_LanceCharge -->
<Defs>
	<!-- 헤비랜스 돌진 능력 미사용 -->
	<AbilityDef>
		<defName>RK_Ability_LanceCharge</defName>
		<label>charge</label>
		<description>Short-range charge toward a hostile target. After landing, movement speed is reduced but melee hit chance increases.</description>
		<cooldownTicksRange>60000~60000</cooldownTicksRange>
		<ai_IsOffensive>true</ai_IsOffensive>
		<aiCanUse>true</aiCanUse>
		<jobDef>CastJump</jobDef>
		<verbProperties>
			<verbClass>NewRatkin.Verb_CastAbilityCharge</verbClass>
			<range>2.9</range>
			<requireLineOfSight>true</requireLineOfSight>
			<warmupTime>0.5</warmupTime>
			<targetParams>
				<canTargetLocations>false</canTargetLocations>
				<canTargetPawns>true</canTargetPawns>
				<canTargetBuildings>false</canTargetBuildings>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="NewRatkin.CompProperties_ChargeOnJump">
				<pawnFlyerDef>RK_PawnFlyer_LanceCharge</pawnFlyerDef>
				<exhaustionHediffDef>RK_Hediff_LanceChargeExhaustion</exhaustionHediffDef>
				<exhaustionDurationTicks>600</exhaustionDurationTicks>
				<focusHediffDef>RK_Hediff_LanceChargeFocus</focusHediffDef>
				<focusDurationTicks>3000</focusDurationTicks>
				<momentumHediffDef>RK_Hediff_LanceChargeMomentum</momentumHediffDef>
				<momentumDurationTicks>600</momentumDurationTicks>
				<onlyHostilePawns>true</onlyHostilePawns>
			</li>
		</comps>
	</AbilityDef>

	<!-- 헤비랜스 돌진 능력 V2: LOS 기반 목적지, 최소 3칸~최대 5칸 -->
	<AbilityDef>
		<defName>RK_Ability_LanceChargeV2</defName>
		<label>charge</label>
		<description>Short-range charge toward a hostile target (3-5 tiles). Stops at the last clear tile before obstacles. After landing, movement speed is reduced but melee hit chance increases.</description>
		<cooldownTicksRange>12000~12000</cooldownTicksRange>
		<ai_IsOffensive>true</ai_IsOffensive>
		<aiCanUse>true</aiCanUse>
		<jobDef>CastJump</jobDef>
		<verbProperties>
			<verbClass>NewRatkin.Verb_CastAbilityChargeV2</verbClass>
			<range>6.9</range>
			<minRange>2.7</minRange>
			<requireLineOfSight>true</requireLineOfSight>
			<warmupTime>0.75</warmupTime>
			<targetParams>
				<canTargetLocations>false</canTargetLocations>
				<canTargetPawns>true</canTargetPawns>
				<canTargetBuildings>true</canTargetBuildings>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="NewRatkin.CompProperties_ChargeOnJump">
				<pawnFlyerDef>RK_PawnFlyer_LanceCharge</pawnFlyerDef>
				<exhaustionHediffDef>RK_Hediff_LanceChargeExhaustion</exhaustionHediffDef>
				<exhaustionDurationTicks>1200</exhaustionDurationTicks>
				<focusHediffDef>RK_Hediff_LanceChargeFocus</focusHediffDef>
				<focusDurationTicks>1200</focusDurationTicks>
				<momentumHediffDef>RK_Hediff_LanceChargeMomentum</momentumHediffDef>
				<momentumDurationTicks>300</momentumDurationTicks>
				<onlyHostilePawns>true</onlyHostilePawns>
			</li>
		</comps>
	</AbilityDef>

	<!-- 랜스 차지 비행체 (돌진 이동용) -->
	<ThingDef ParentName="PawnFlyerBase">
		<defName>RK_PawnFlyer_LanceCharge</defName>
		<pawnFlyer>
			<flightDurationMin>0.3</flightDurationMin>
			<flightSpeed>20</flightSpeed>
			<heightFactor>0.0</heightFactor>
		</pawnFlyer>
	</ThingDef>

	<!-- 랜스 차지 후 피로 (이동속도 감소) -->
	<HediffDef>
		<defName>RK_Hediff_LanceChargeExhaustion</defName>
		<label>lance charge exhaustion</label>
		<description>Exhausted from the lance charge. Movement speed reduced.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>600~600</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<statOffsets>
					<MoveSpeed>-1.6</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

	<!-- 랜스 차지 후 집중 (근접 명중률 증가) -->
	<HediffDef>
		<defName>RK_Hediff_LanceChargeFocus</defName>
		<label>lance charge focus</label>
		<description>Focused from the lance charge. Melee hit chance increased.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>2400~2400</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<statOffsets>
					<MeleeHitChance>0.4</MeleeHitChance>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

	<!-- 랜스 차지 모멘텀 (최초 공격 시 피해량 +25%, 공격 시 소멸) -->
	<HediffDef>
		<defName>RK_Hediff_LanceChargeMomentum</defName>
		<label>lance charge momentum</label>
		<description>Momentum from the lance charge. First melee attack deals 25% more damage, then this effect is consumed.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>300~300</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>
		<stages>
			<li>
				<statOffsets>
					<MeleeDamageFactor>0.25</MeleeDamageFactor>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>
</Defs>
