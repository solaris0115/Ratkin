		</statBases>
		<equippedStatOffsets>
		</equippedStatOffsets>
		<comps>
			<li Class="NewRatkin.CompProperties_ExtraDrawer">
				<!-- 방패 조건부 드로잉 Comp -->
				<drawSize>(1.0, 1.0)</drawSize>
				<!-- 소집 시 드로잉 데이터 (그래픽 경로 + 팔/어깨 위치) -->
				<draftedDrawData>
					<graphicPath>Apparel/Util/RK_WoodenShield</graphicPath>
					<offsetNorth>(-0.2, -0.2, -0.09)</offsetNorth>
					<offsetSouth>(0.2, 0.2, -0.15)</offsetSouth>
					<offsetEast>(0.2, -0.2, -0.2)</offsetEast>
					<offsetWest>(-0.2, 0.2, -0.15)</offsetWest>
					<angleNorth>0</angleNorth>
					<angleSouth>0</angleSouth>
					<angleEast>0</angleEast>
					<angleWest>0</angleWest>
				</draftedDrawData>

				<!-- 비소집 시 드로잉 데이터 (그래픽 경로 + 등 위치) -->
				<backDrawData>
					<graphicPath>Apparel/Util/RK_WoodenShieldUnarm</graphicPath>
					<offsetNorth>(0, 0.2, -0.2)</offsetNorth>
					<offsetSouth>(0, -0.2, -0.09)</offsetSouth>
					<offsetEast>(-0.15, 0.05, -0.07)</offsetEast>
					<offsetWest>(0.15, -2.0, -0.07)</offsetWest>
					<angleNorth>0</angleNorth>
					<angleSouth>0</angleSouth>
					<angleEast>15</angleEast>
					<angleWest>-15</angleWest>
				</backDrawData>
			</li>
			<li Class="NewRatkin.CompProperties_ShieldWeaponIncompatible">
				<!-- 방패와 무기 동시 착용 제한 Comp -->
				<!-- allowedWeaponTags: 허용할 무기 태그 리스트 (화이트리스트) -->
				<!-- RK_WeaponTag_OneHand 태그를 가진 무기만 허용하고 나머지는 차단 -->
				<allowedWeaponTags>
					<li>RK_WeaponTag_OneHand</li>
					<li>RK_WeaponTag_LightShieldCompatible</li>
				</allowedWeaponTags>
				<blockReasonKey>RK_ShieldWeaponIncompatible</blockReasonKey>
			</li>
			<li Class="NewRatkin.CompProperties_StaminaShield">
				<!-- StaminaShield 컴포넌트 -->
				<startingTicksToReset>180</startingTicksToReset>
				<stunDurationTicks>180</stunDurationTicks>
				<durabilityDamagePercent>0.1</durabilityDamagePercent>
				<staminaOnReset>0.2</staminaOnReset>
				<staminaLossPerDamageMelee>0.066</staminaLossPerDamageMelee>
				<staminaLossPerDamageRanged>0.033</staminaLossPerDamageRanged>
				<staminaLossPerDamageExplosive>0.1</staminaLossPerDamageExplosive>
				<damageReductionPercentMelee>0.4</damageReductionPercentMelee>
				<damageReductionPercentRanged>0.5</damageReductionPercentRanged>
				<damageReductionPercentExplosive>0.25</damageReductionPercentExplosive>
			</li>
		</comps>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
			</bodyPartGroups>
			<tags>
				<li>RK_LightArmor</li>
			</tags>
		</apparel>
	</ThingDef>

