<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- TODO: NO quality base가 되어야함. -->
	<ThingDef Name="RK_ApparelAttr_UtilBase" ParentName="ApparelNoQualityBase" Abstract="True">

	</ThingDef>

	<ThingDef Name="RK_ApparelAttr_BackpackBase" ParentName="RK_ApparelAttr_UtilBase" Abstract="True">
		<apparel>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<layers>
				<li>BackPack</li>
			</layers>
			<defaultOutfitTags>
				<li>Worker</li>
				<li>Soldier</li>
			</defaultOutfitTags>
			<tags inherit="false">
				<li>RK_ApparelTag_All</li>
			</tags>
		</apparel>
		<tradeTags inherit="false">
			<li>RK_TradeTag_Cloth</li>
		</tradeTags>
		<techLevel>Medieval</techLevel>
	</ThingDef>

	<!-- 봇짐 운반 용량 +10 -->
	<ThingDef ParentName="RK_ApparelAttr_BackpackBase">
		<defName>RK_Apparel_CrossBack</defName>
		<label>cross back</label>
		<description>간단한 봇짐입니다. 짐을 조금 더 나를 수 있게 해줍니다.</description>
		<graphicData>
			<texPath>Thing/Apparel/RK_TextureApparel_CrossBack</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<costStuffCount>35</costStuffCount>
		<costList>
			<Steel>10</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToMake>3500</WorkToMake>
			<Mass>0.3</Mass>
		</statBases>
		<equippedStatOffsets>
			<CarryingCapacity>10</CarryingCapacity>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>Thing/Apparel/RK_TextureApparel_CrossBack</wornGraphicPath>
			<tags>
				<li>RK_ApparelTag_Colonist</li>
				<li>RK_ApparelTag_Worker</li>
				<li>RK_ApparelTag_Pilgrim</li>
			</tags>
		</apparel>
		<recipeMaker>
			<recipeUsers>
				<li>RK_Building_HandTailor</li>
				<li>RK_Building_ElectricTailor</li>
			</recipeUsers>
			<displayPriority>1100</displayPriority>
		</recipeMaker>
	</ThingDef>

	<!-- 가방  운반용량 +18 -->
	<ThingDef ParentName="RK_ApparelAttr_BackpackBase">
		<defName>RK_Apparel_Backpack</defName>
		<label>backpack</label>
		<description>등에 맬 수 있는 가방입니다. 짐을 더 많이 나를 수 있게 해줍니다.</description>
		<graphicData>
			<texPath>Thing/Apparel/RK_TextureApparel_Backpack</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costList>
			<Steel>10</Steel>
		</costList>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<costStuffCount>45</costStuffCount>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>5500</WorkToMake>
			<Mass>0.5</Mass>
			<ArmorRating_Sharp>0.05</ArmorRating_Sharp>
		</statBases>
		<equippedStatOffsets>
			<CarryingCapacity>18</CarryingCapacity>
		</equippedStatOffsets>
		<recipeMaker>
			<recipeUsers>
				<li>RK_Building_HandTailor</li>
				<li>RK_Building_ElectricTailor</li>
			</recipeUsers>
			<displayPriority>1100</displayPriority>
			<researchPrerequisite>RK_Research_1TierCloth</researchPrerequisite>
		</recipeMaker>
		<apparel>
			<wornGraphicPath>Thing/Apparel/RK_TextureApparel_Backpack</wornGraphicPath>
			<tags>
				<li>RK_ApparelTag_1Tier</li>
				<li>RK_ApparelTag_RangeFighter</li>
				<li>RK_ApparelTag_Worker</li>
				<li>RK_ApparelTag_Pilgrim</li>
			</tags>
		</apparel>
	</ThingDef>

