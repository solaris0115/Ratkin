	<ThingDef ParentName="RK_ApparelMakeableBase">
		<defName>RK_CrossBack</defName>
		<label>cross back</label>
		<description>간단한 봇짐입니다. 짐을 조금 더 나를 수 있게 해줍니다.</description>
		<graphicData>
			<texPath>Apparel/RK_CrossBack</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costStuffCount>45</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<costList>
			<Steel>5</Steel>
		</costList>
		<statBases>
			<MaxHitPoints>85</MaxHitPoints>
			<WorkToMake>3500</WorkToMake>
			<Mass>0.3</Mass>
			<EquipDelay>0.8</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<CarryingCapacity>15</CarryingCapacity>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Worker</li>
				<li>Soldier</li>
			</defaultOutfitTags>
			<wornGraphicPath>Apparel/RK_CrossBack</wornGraphicPath>
