<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="ApparelMakeableBase">
		<defName>RK_Apparel_Banner</defName>
		<label>war banner</label>
		<description>주변 아군을 브루스 배너로 만듭니다.</description>
		<graphicData>
			<texPath>Apparel/Util/RK_TextureApparel_Banner</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costList>
			<WoodLog>100</WoodLog>
		</costList>
		<costStuffCount>120</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<techLevel>Medieval</techLevel>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>25000</WorkToMake>
			<Mass>2</Mass>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<MeleeDodgeChance>-0.15</MeleeDodgeChance>
		</equippedStatOffsets>
		<comps>
			<li Class="NewRatkin.CompProperties_BannerDrawer">
				<!-- 배너 조건부 드로잉 Comp -->
				<drawSize>(1.0, 1.0)</drawSize>
				
				<!-- 소집 시 드로잉 데이터 (그래픽 경로 + 팔/어깨 위치) -->
				<draftedDrawData>
					<graphicPath>Apparel/Util/RK_TextureApparel_BannerArm</graphicPath>
					<offsetNorth>(-0.25, -0.18, -0.08)</offsetNorth>
					<offsetSouth>(0.25, 0.15, -0.08)</offsetSouth>
					<offsetEast>(0.25, -0.12, -0.12)</offsetEast>
					<offsetWest>(-0.25, 0.12, -0.12)</offsetWest>
					<angleNorth>-15</angleNorth>
					<angleSouth>15</angleSouth>
					<angleEast>15</angleEast>
					<angleWest>-15</angleWest>
				</draftedDrawData>
				
				<!-- 비소집 시 드로잉 데이터 (그래픽 경로 + 등 위치) -->
				<backDrawData>
					<graphicPath>Apparel/Util/RK_TextureApparel_BannerUnarm</graphicPath>
					<offsetNorth>(-0.25, -0.18, -0.08)</offsetNorth>
					<offsetSouth>(0.25, 0.15, -0.08)</offsetSouth>
					<offsetEast>(0.25, -0.12, -0.12)</offsetEast>
					<offsetWest>(-0.25, 0.12, -0.12)</offsetWest>
					<angleNorth>-15</angleNorth>
					<angleSouth>15</angleSouth>
					<angleEast>15</angleEast>
					<angleWest>-15</angleWest>
				</backDrawData>
			</li>
		</comps>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<wornGraphicPath>Apparel/Util/RK_TextureApparel_Banner</wornGraphicPath>
			<layers>
				<li>OuterClothing</li>
			</layers>
			<tags>
				<li>RK_ApparelTag_All</li>
				<li>RK_ApparelTag_Banner</li>
				<li>RK_ApparelTag_Support</li>
				<li>RK_ApparelTag_Buffer</li>
			</tags>
			<abilities>
				<li>RK_Ability_MeleeMoraleBooster</li>
			</abilities>
		</apparel>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
			<!-- TODO: 사기 진작 아이템 연구 필요 -->
			<!-- <researchPrerequisite>RK_Research_MoraleBooster</researchPrerequisite> -->
			<recipeUsers Inherit="false">
				<li>RK_FueledSmithy</li>
				<li>RK_ElectricSmithy</li>
			</recipeUsers>
		</recipeMaker>
	</ThingDef>
</Defs>
