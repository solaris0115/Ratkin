	</ThingDef>

	<ThingDef Name="RK_ApparelAttr_ArmorHelmetMakeableBase" ParentName="RK_ApparelAttr_ArmorMachineableBase" Abstract="True">
		<thingCategories>
			<li>RK_ThingCategory_Headgear</li>
		</thingCategories>
		<tradeTags>
			<li>RK_TradeTag_Cloth</li>
		</tradeTags>
