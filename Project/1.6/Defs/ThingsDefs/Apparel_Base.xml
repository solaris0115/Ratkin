<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        랫킨 장비는 기본적으로 색상을 고정
        색상을 따라가야하는 경우 반드시 followStuffColor을 true로 설정
        

    -->
    <!-- 일반 의류  -->
    <ThingDef Name="RK_ApparelAttr_ApparelMakeableBase" ParentName="ApparelMakeableBase" Abstract="True">
        <recipeMaker>
            <recipeUsers Inherit="false">
                <li>RK_Building_ElectricTailoringBench</li>
                <li>RK_Building_HandTailoringBench</li>
            </recipeUsers>
        </recipeMaker>
        <tradeTags>
            <li>RK_TradeTag_Clothing</li>
        </tradeTags>
        <apparel>
            <tags>
                <li>RK_ApparelTag_All</li>
            </tags>
        </apparel>
        <statBases>
            <EquipDelay>0.5</EquipDelay>
        </statBases>
    </ThingDef>

    <!-- 갑옷 -->
    <ThingDef Name="RK_ApparelAttr_ArmorSmithableBase" ParentName="ArmorSmithableBase" Abstract="True">
        <smeltable>true</smeltable>
        <recipeMaker>
            <recipeUsers Inherit="false">
                <li>RK_Building_ElectricSmithy</li>
                <li>RK_Building_FueledSmithy</li>
            </recipeUsers>
        </recipeMaker>
        <tradeTags>
            <li>RK_TradeTag_Clothing</li>
        </tradeTags>
        <apparel>
            <tags>
                <li>RK_ApparelTag_All</li>
            </tags>
        </apparel>
        <statBases>
            <EquipDelay>1.5</EquipDelay>
        </statBases>
    </ThingDef>

    <!-- 랫킨은 기계 벤치가 없음 -->
    <ThingDef Name="RK_ApparelAttr_ArmorMachineableBase" ParentName="ArmorMachineableBase" Abstract="True">
        <tradeTags>
            <li>RK_TradeTag_Armor</li>
        </tradeTags>
        <apparel>
            <tags>
                <li>RK_ApparelTag_All</li>
            </tags>
        </apparel>
        <statBases>
            <EquipDelay>1.5</EquipDelay>
        </statBases>
    </ThingDef>


    <!-- 머리 장비 ===================================================  -->
    <ThingDef Name="RK_ApparelAttr_HatBase" ParentName="HatBase" Abstract="True">
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <thingCategories>
            <li>RK_ThingCategory_Headgear</li>
        </thingCategories>
        <tradeTags>
            <li>RK_TradeTag_Clothing</li>
        </tradeTags>
        <apparel>
            <tags>
                <li>RK_ApparelTag_All</li>
            </tags>
        </apparel>
        <statBases>
            <EquipDelay>0.5</EquipDelay>
        </statBases>
    </ThingDef>

    <ThingDef Name="RK_ApparelAttr_HatMakeableBase" ParentName="RK_ApparelAttr_ArmorSmithableBase" Abstract="True">
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <thingCategories>
            <li>RK_ThingCategory_Headgear</li>
        </thingCategories>
        <tradeTags>
            <li>RK_TradeTag_Armor</li>
        </tradeTags>
        <apparel>
            <tags>
                <li>RK_ApparelTag_All</li>
            </tags>
        </apparel>
        <statBases>
            <EquipDelay>1</EquipDelay>
        </statBases>
    </ThingDef>

    <ThingDef Name="RK_ApparelAttr_HelmetMakeableBase" ParentName="RK_ApparelAttr_ArmorMachineableBase" Abstract="True">
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <thingCategories>
            <li>RK_ThingCategory_Headgear</li>
        </thingCategories>
        <tradeTags>
            <li>RK_TradeTag_Clothing</li>
        </tradeTags>
        <apparel>
            <tags>
                <li>RK_ApparelTag_All</li>
            </tags>
        </apparel>
    </ThingDef>

    <ThingDef Name="RK_ApparelAttr_NobleHatMakeableBase" ParentName="NobleHatMakeableBase" Abstract="True">
        <countsAsClothingForNudity>false</countsAsClothingForNudity>
        <thingCategories>
            <li>RK_ThingCategory_Headgear</li>
        </thingCategories>
        <tradeTags>
            <li>RK_TradeTag_Clothing</li>
        </tradeTags>
        <apparel>
            <tags>
                <li>RK_ApparelTag_All</li>
            </tags>
        </apparel>
        <statBases>
            <EquipDelay>0.5</EquipDelay>
        </statBases>
    </ThingDef>

    <!-- 생산이 불가능한 것들은 림월드 기존것들 참고하여 생성
    대게는 ApparelBase를 상속받아서 직접 구현됨. -->
</Defs>
