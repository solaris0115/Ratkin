<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        랫킨 장비는 기본적으로 색상을 고정
        색상을 따라가야하는 경우 반드시 followStuffColor을 true로 설정
        

    -->
    <!-- 일반 의류  -->
    <ThingDef Name="RK_ApparelAttr_ApparelMakeableBase" ParentName="ApparelMakeableBase" Abstract="True">
        <followStuffColor>false</followStuffColor>
        <recipeMaker>
            <recipeUsers>
                <li>RK_Building_ElectricTailoringBench</li>
                <li>RK_Building_HandTailoringBench</li>
            </recipeUsers>
        </recipeMaker>
        <tradeTags>
            <li>RK_TradeTag_Cloth</li>
        </tradeTags>
    </ThingDef>

    <ThingDef Name="RK_ApparelAttr_ArmorSmithableBase" ParentName="ArmorSmithableBase" Abstract="True">
        <followStuffColor>false</followStuffColor>
        <smeltable>true</smeltable>
        <recipeMaker>
            <recipeUsers>
                <li>RK_Building_ElectricSmithy</li>
                <li>RK_Building_FueledSmithy</li>
            </recipeUsers>
        </recipeMaker>
        <tradeTags>
            <li>RK_TradeTag_Cloth</li>
        </tradeTags>
    </ThingDef>

    <!-- 랫킨은 기계 벤치가 없음 -->
    <ThingDef Name="RK_ApparelAttr_ArmorMachineableBase" ParentName="ArmorMachineableBase" Abstract="True">
        <followStuffColor>false</followStuffColor>
        <recipeMaker>
            <recipeUsers>
                <li>RK_Building_ElectricSmithy</li>
                <li>RK_Building_FueledSmithy</li>
            </recipeUsers>
        </recipeMaker>
        <tradeTags>
            <li>RK_TradeTag_Cloth</li>
        </tradeTags>
    </ThingDef>


    <!-- 여기서부터 머리 장비  -->
    <ThingDef Name="RK_ApparelAttr_HatBase" ParentName="HatBase" Abstract="True">
        <followStuffColor>false</followStuffColor>
        <thingCategories>
            <li>RK_ThingCategory_Headgear</li>
        </thingCategories>
        <tradeTags>
            <li>RK_TradeTag_Cloth</li>
        </tradeTags>
    </ThingDef>

    <ThingDef Name="RK_ApparelAttr_HatMakeableBase" ParentName="RK_ApparelAttr_ApparelMakeableBase" Abstract="True">
        <followStuffColor>false</followStuffColor>
        <thingCategories>
            <li>RK_ThingCategory_Headgear</li>
        </thingCategories>
        <tradeTags>
            <li>RK_TradeTag_Armor</li>
        </tradeTags>
    </ThingDef>

    <ThingDef Name="RK_ApparelAttr_ArmorHelmetMakeableBase" ParentName="RK_ApparelAttr_ArmorMachineableBase" Abstract="True">
        <followStuffColor>false</followStuffColor>
        <thingCategories>
            <li>RK_ThingCategory_Headgear</li>
        </thingCategories>
        <tradeTags>
            <li>RK_TradeTag_Cloth</li>
        </tradeTags>
    </ThingDef>

    <ThingDef Name="RK_ApparelAttr_NobleHatMakeableBase" ParentName="RK_ApparelAttr_MakeableBase" Abstract="True">
        <followStuffColor>false</followStuffColor>
        <thingCategories>
            <li>RK_ThingCategory_Headgear</li>
        </thingCategories>
        <tradeTags>
            <li>RK_TradeTag_Cloth</li>
        </tradeTags>
    </ThingDef>
</Defs>
