	<!-- RatHolic Gun 통합 관리 Hediff (영구 지속) -->
	<HediffDef>
		<defName>RK_Hediff_RatHolicGun</defName>
		<label>RatHolic Gun Spooling Manager</label>
		<description>Manages RatHolic Gun spooling effects.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<!-- 영구 지속 -->
		<!-- UI에서 숨김 - 유저에게 드러나지 않음 -->
		<stages>
			<li>
				<becomeVisible>false</becomeVisible>
			</li>
		</stages>
		<comps>
			<!-- 통합 Comp: 타겟 변경 시 제거할 Hediff와 사격 중이 아닐 때 제거할 Hediff 관리 -->
			<li Class="NewRatkin.HediffCompProperties_RatHolicGun">
				<targetChangeRemoveHediffs>
					<li>RK_Hediff_RatHolicGunSpoolingAim</li>
				</targetChangeRemoveHediffs>
				<notFiringRemoveHediffs>
					<li>RK_Hediff_RatHolicGunSpoolingAim</li>
					<li>RK_Hediff_RatHolicGunSpooling</li>
				</notFiringRemoveHediffs>
			</li>
		</comps>
	</HediffDef>

	<!-- RatHolic Gun 발사 속도 증가 버프 -->
	<HediffDef>
		<defName>RK_Hediff_RatHolicGunSpooling</defName>
		<label>spooling up</label>
		<description>The weapon is spooling up, reducing reload time with each shot fired.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<isBad>false</isBad>
		<!-- 최대 Severity 1.2 = 6중첩 (코드에서 Severity로 중첩 처리: 0.2=1스택, 0.4=2스택, ..., 1.2=6스택) -->
		<maxSeverity>1</maxSeverity>
		<stages>
			<!-- Stage 1: 1스택 (Severity 0.2) - RK_Stat_RangeCoolDownMultiplier: 0.5× (선형: 0.5→0.1) -->
			<li>
				<minSeverity>0.2</minSeverity>
				<!-- UI에서 숨김 - 유저에게 드러나지 않음 -->
				<becomeVisible>false</becomeVisible>
				<statFactors>
					<RK_Stat_RangeCoolDownMultiplier>0.5</RK_Stat_RangeCoolDownMultiplier>
				</statFactors>
			</li>
			<!-- Stage 2: 2스택 (Severity 0.4) - RK_Stat_RangeCoolDownMultiplier: 0.4× (선형: 0.5→0.1) -->
			<li>
				<minSeverity>0.4</minSeverity>
				<becomeVisible>false</becomeVisible>
				<statFactors>
					<RK_Stat_RangeCoolDownMultiplier>0.4</RK_Stat_RangeCoolDownMultiplier>
				</statFactors>
			</li>
			<!-- Stage 3: 3스택 (Severity 0.6) - RK_Stat_RangeCoolDownMultiplier: 0.3× (선형: 0.5→0.1) -->
			<li>
				<minSeverity>0.6</minSeverity>
				<becomeVisible>false</becomeVisible>
				<statFactors>
					<RK_Stat_RangeCoolDownMultiplier>0.3</RK_Stat_RangeCoolDownMultiplier>
				</statFactors>
			</li>
			<!-- Stage 4: 4스택 (Severity 0.8) - RK_Stat_RangeCoolDownMultiplier: 0.2× (선형: 0.5→0.1) -->
			<li>
				<minSeverity>0.8</minSeverity>
				<becomeVisible>false</becomeVisible>
				<statFactors>
					<RK_Stat_RangeCoolDownMultiplier>0.2</RK_Stat_RangeCoolDownMultiplier>
				</statFactors>
			</li>
			<!-- Stage 5: 5스택 (Severity 1.0) - RK_Stat_RangeCoolDownMultiplier: 0.1× (선형: 0.5→0.1) -->
			<li>
				<minSeverity>1.0</minSeverity>
				<becomeVisible>false</becomeVisible>
				<statFactors>
					<RK_Stat_RangeCoolDownMultiplier>0.1</RK_Stat_RangeCoolDownMultiplier>
				</statFactors>
			</li>
		</stages>
	</HediffDef>

	<!-- RatHolic Gun 조준 속도 증가 버프 -->
	<HediffDef>
		<defName>RK_Hediff_RatHolicGunSpoolingAim</defName>
