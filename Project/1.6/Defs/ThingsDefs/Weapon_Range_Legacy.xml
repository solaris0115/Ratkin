<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- LEGACY: 구 세이브·ParentName(RK_WeaponAttr_Rifle_line)·코드 호환. 생산 불가. 대체 무기: RK_Weapon_SawedOff -->
	<ThingDef ParentName="RK_IndustrialRangeWeapon" Name="RK_WeaponAttr_Rifle_line">
		<defName>RK_Rifle_line</defName>
		<label>ratkin shotgun</label>
		<description>소드오프 샷건입니다. 랫킨 왕국에서는 샷건이 랫킨을 쏩니다.</description>
		<recipeMaker Inherit="False" IsNull="True" />
		<costList>
			<WoodLog>30</WoodLog>
			<Steel>55</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<graphicData>
			<texPath>Weapon/RK_Shotgun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<statBases>
			<WorkToMake>11000</WorkToMake>
			<Mass>2</Mass>
			<AccuracyTouch>0.85</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.55</AccuracyLong>
			<RangedWeapon_Cooldown>1.3</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li Class="NewRatkin.VerbProperties_SectorShot">
				<verbClass>NewRatkin.Verb_SectorShot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<canGoWild>true</canGoWild>
				<warmupTime>0.9</warmupTime>
				<range>7</range>
				<soundCast>FlechetteRifle</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>4</muzzleFlashScale>
				<sectorRadius>2.7</sectorRadius>
				<sectorAngle>140</sectorAngle>
				<vertexOffset>0</vertexOffset>
				<sectorDamageAmount>7</sectorDamageAmount>
				<sectorArmorPenetration>0.2</sectorArmorPenetration>
				<effectsPerCellMin>1</effectsPerCellMin>
				<effectsPerCellMax>3</effectsPerCellMax>
				<hitRepeatMin>2</hitRepeatMin>
				<hitRepeatMax>3</hitRepeatMax>
				<hitRepeatOverlapCap>6</hitRepeatOverlapCap>
				<muzzleEffectOffset>1</muzzleEffectOffset>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>7</power>
				<cooldownTime>1.8</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>7</power>
				<cooldownTime>1.8</cooldownTime>
			</li>
		</tools>
		<weaponTags Inherit="false">
			<li>RK_2TierWeapon</li>
			<li>RK_Shotgun</li>
			<li>RK_WeaponTag_OneHand</li>
			<li>RK_WeaponTag_OneHandRange</li>
			<li>RK_WeaponTag_OneHandRangeAttack</li>
		</weaponTags>
		<tradeTags>
			<li>RK_TradeTag_2TierWeapon</li>
		</tradeTags>
		<equippedAngleOffset>45</equippedAngleOffset>
	</ThingDef>

	<!-- LEGACY: Verb_SectorShot 코드가 ThingDef.Named 참조. 제작 레시피 없음 -->
	<ThingDef ParentName="BaseBullet">
		<defName>RK_Bullet_SectorShot_Dummy</defName>
		<label>sector shot tracer</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>Transparent</shaderType>
			<drawSize>0.001</drawSize>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>0</damageAmountBase>
			<armorPenetrationBase>0</armorPenetrationBase>
			<speed>160</speed>
		</projectile>
	</ThingDef>
</Defs>
