	<!-- 판금 갑옷 -->
	<ThingDef ParentName="RK_ApparelAttr_Plate">
		<defName>RK_Plate_Unique</defName>
		<label>unique ratkin plate armor</label>
		<description>A unique ratkin plate armor with enhanced protection and craftsmanship.</description>
		
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable" />
			<li>
				<compClass>CompColorable</compClass>
			</li>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtApparel</nameMaker>
				<descriptionMaker>ArtDescription_Apparel</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
		</comps>
		
		<generateAllowChance>0</generateAllowChance>
		<possessionCount>0</possessionCount>
		<tradeability>Sellable</tradeability>
		<recipeMaker Inherit="False" IsNull="True" />
	</ThingDef>

