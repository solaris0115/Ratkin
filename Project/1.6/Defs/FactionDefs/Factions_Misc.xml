<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<FactionDef ParentName="FactionBase" Name="RK_FactionAttr_FactionBase" Abstract="True">
		<pawnSingular>ratkin</pawnSingular>
		<pawnsPlural>Ratkins</pawnsPlural>
		<categoryTag>RatkinStory</categoryTag>
		<listOrderPriority>30</listOrderPriority>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<requiredCountAtGameStart>2</requiredCountAtGameStart>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<leaderTitle>prime executor</leaderTitle>
		<factionIconPath>UI/Icon/RK_TextureIcon_DefaultFaction</factionIconPath>
		<techLevel>Medieval</techLevel>
		<!--TODO: 랫킨 네이밍 필요-->
		<factionNameMaker>RK_RulePack_NamerFaction</factionNameMaker>
		<settlementNameMaker>RK_RulePack_NamerSettlement</settlementNameMaker>
		<allowedCultures>			<!--TODO: 랫킨 문화 필요-->
			<li>Rustican</li>
		</allowedCultures>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>
		<structureMemeWeights>
			<Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">1</Structure_TheistEmbodied>
			<Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">2</Structure_TheistAbstract>
			<Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
			<Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Archist>
			<Structure_OriginChristian MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginChristian>
			<Structure_OriginIslamic MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginIslamic>
			<Structure_OriginHindu MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginHindu>
			<Structure_OriginBuddhist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginBuddhist>
		</structureMemeWeights>
		<melaninRange>0~0.3</melaninRange>
		<backstoryFilters>
			<li>
				<categories>
					<li>Outlander</li>
				</categories>
				<commonality>0.70</commonality>
			</li>
			<li>
				<categories>
					<li>Offworld</li>
				</categories>
				<commonality>0.30</commonality>
			</li>
		</backstoryFilters>
		<!--TODO: 랫킨 방문자 설정 필요-->
		<visitorTraderKinds>
			<li>Visitor_Outlander_Standard</li>
		</visitorTraderKinds>
		<!--TODO: 랫킨 상인 설정 필요-->
		<baseTraderKinds>
			<li>Base_Outlander_Standard</li>
		</baseTraderKinds>
		<!--TODO: 랫킨 캐러반 설정 필요-->
		<caravanTraderKinds>
			<li>Caravan_Outlander_BulkGoods</li>
			<li>Caravan_Outlander_CombatSupplier</li>
			<li>Caravan_Outlander_Exotic</li>
			<li>Caravan_Outlander_PirateMerchant</li>
		</caravanTraderKinds>
		<allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<!-- TODO: 랫킨 그룹 설정 필요-->
		<pawnGroupMakers>
			<li>
				<kindDef>Combat</kindDef>
				<commonality>100</commonality>
				<maxTotalPoints>1000</maxTotalPoints>
				<options>
					<RK_PawnKind_FighterTemp>20</RK_PawnKind_FighterTemp>
				</options>
			</li>
			<!-- 초반 혼합-->
			<li>
				<kindDef>Combat</kindDef>
				<commonality>100</commonality>
				<maxTotalPoints>1000</maxTotalPoints>
				<options>
					<RK_PawnKind_FighterTemp>5</RK_PawnKind_FighterTemp>
				</options>
			</li>
			<!-- 중후반 군인-->
			<li>
				<kindDef>Combat</kindDef>
				<commonality>50</commonality>
				<options>
					<RK_PawnKind_FighterTemp>30</RK_PawnKind_FighterTemp>
				</options>
			</li>
		</pawnGroupMakers>
		<settlementTexturePath>UI/Icon/RK_TextureIcon_DefaultFaction</settlementTexturePath>
		<apparelStuffFilter>
			<stuffCategoriesToAllow>
				<li>Fabric</li>
				<li>Leathery</li>
				<li>Woody</li>
			</stuffCategoriesToAllow>
		</apparelStuffFilter>
	</FactionDef>

	<FactionDef ParentName="RK_FactionAttr_FactionBase">
		<defName>RK_Faction_Rakinia</defName>
		<label>ratkin kingdom</label>
		<description>랫킨 왕국입니다. 인간들 눈에 띄지 않도록 숨어서 살고 있으며 농경생활을 위주로 생활하는 비 침략적인 종족입니다.</description>
		<colorSpectrum>
			<li>(0.45, 0.50, 0.30)</li>
			<li>(0.65, 0.60, 0.20)</li>
		</colorSpectrum>
		<layerWhitelist>
			<li>Surface</li>
		</layerWhitelist>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>
		<maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation><!-- 없으면 월드맵에서 생성이 앙됨.-->
		<configurationListOrderPriority>30</configurationListOrderPriority>
		<!-- 각 팩션마다 고유 병종이나 전략 전술 설정이 필요. 왕국과 제국만 종교 그룹을 갖어야함 -->
	</FactionDef>
</Defs>
