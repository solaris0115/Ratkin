<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<FactionDef ParentName="FactionBase" Name="RK_FactionBase" Abstract="True">
		<pawnSingular>ratkin</pawnSingular>
		<pawnsPlural>ratkins</pawnsPlural>
		<categoryTag>RK_BackStroyCategory_Default</categoryTag>
		<listOrderPriority>30</listOrderPriority>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<maxConfigurableAtWorldCreation>2</maxConfigurableAtWorldCreation>
		<canMakeRandomly>true</canMakeRandomly>
		<leaderTitle>prime executor</leaderTitle>
		<factionNameMaker>NamerFaction_RatkinKingdom</factionNameMaker>
		<settlementNameMaker>NamerSettlement_RatkinKingdom</settlementNameMaker>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<factionIconPath>Icon/RK_icon</factionIconPath>
		<techLevel>Industrial</techLevel>
		<melaninRange>0~0.3</melaninRange>
		<backstoryCategories>
			<li>Offworld</li>
		</backstoryCategories>
		<caravanTraderKinds>
			<li>Caravan_Ratkin_BulkGoods</li>
			<li>Caravan_Ratkin_DressMerchant</li>
			<li>Caravan_Ratkin_CombatSupplier</li>
			<li>Caravan_Ratkin_Free_company</li>
		</caravanTraderKinds>
		<visitorTraderKinds>
			<li>Visitor_Outlander_Standard</li>
		</visitorTraderKinds>
		<baseTraderKinds>
			<li>Base_Outlander_Standard</li>
		</baseTraderKinds>
		<allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<pawnGroupMakers>
			<li>
				<kindDef>Combat</kindDef>
				<commonality>100</commonality>
				<maxTotalPoints>1000</maxTotalPoints>
				<options>
					<RK_PawnKind_Combatant>20</RK_PawnKind_Combatant>
					<RK_PawnKind_Soldier>5</RK_PawnKind_Soldier>
				</options>
			</li>
			<!-- 초반 혼합-->
			<li>
				<kindDef>Combat</kindDef>
				<commonality>100</commonality>
				<maxTotalPoints>1000</maxTotalPoints>
				<options>
					<RK_PawnKind_Defender>5</RK_PawnKind_Defender>
					<RK_PawnKind_Vanguard>10</RK_PawnKind_Vanguard>
					<RK_PawnKind_Combatant>15</RK_PawnKind_Combatant>
				</options>
			</li>
			<!-- 중후반 군인-->
			<li>
				<kindDef>Combat</kindDef>
				<commonality>50</commonality>
				<options>
					<RK_PawnKind_Soldier>30</RK_PawnKind_Soldier>
					<RK_PawnKind_EliteSoldier>5</RK_PawnKind_EliteSoldier>
					<RK_PawnKind_DemonMan>5</RK_PawnKind_DemonMan>
					<RK_PawnKind_Defender>15</RK_PawnKind_Defender>
					<RK_PawnKind_EliteGuardener>15</RK_PawnKind_EliteGuardener>
				</options>
			</li>
			<!-- 중후반 디펜더, 가드너,기사-->
			<li>
				<kindDef>Combat</kindDef>
				<disallowedStrategies>
					<li>Siege</li>
				</disallowedStrategies>
				<commonality>30</commonality>
				<options>
					<RK_PawnKind_EliteGuardener>30</RK_PawnKind_EliteGuardener>
					<RK_PawnKind_Knight>30</RK_PawnKind_Knight>
					<RK_PawnKind_EliteDefender>15</RK_PawnKind_EliteDefender>
				</options>
			</li>
			<!-- 중후반 엘리트 디펜더, 기사, 커맨더-->
			<li>
				<kindDef>Combat</kindDef>
				<disallowedStrategies>
					<li>Siege</li>
				</disallowedStrategies>
				<commonality>20</commonality>
				<options>
					<RK_PawnKind_Knight>30</RK_PawnKind_Knight>
					<RK_PawnKind_EliteDefender>20</RK_PawnKind_EliteDefender>
					<RK_PawnKind_KnightCommander>5</RK_PawnKind_KnightCommander>
				</options>
			</li>
			<li>
				<kindDef>Peaceful</kindDef>
				<options>
					<RK_PawnKind_Noble>10</RK_PawnKind_Noble>
					<RK_PawnKind_Colonist>20</RK_PawnKind_Colonist>
					<RK_PawnKind_Servant>15</RK_PawnKind_Servant>
					<RK_PawnKind_EliteGuardener>10</RK_PawnKind_EliteGuardener>
					<RK_PawnKind_Knight>10</RK_PawnKind_Knight>
					<RK_PawnKind_Priest>10</RK_PawnKind_Priest>
				</options>
			</li>
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<RK_PawnKind_Merchant>15</RK_PawnKind_Merchant>
					<RK_PawnKind_Noble>8</RK_PawnKind_Noble>
				</traders>
				<carriers>
					<RK_PawnKind_KingHamster>6</RK_PawnKind_KingHamster>
				</carriers>
				<guards>
					<RK_PawnKind_Combatant>10</RK_PawnKind_Combatant>
					<RK_PawnKind_MercenaryLight>15</RK_PawnKind_MercenaryLight>
					<RK_PawnKind_Soldier>20</RK_PawnKind_Soldier>
					<RK_PawnKind_EliteGuardener>10</RK_PawnKind_EliteGuardener>
					<RK_PawnKind_Defender>10</RK_PawnKind_Defender>
				</guards>
			</li>
			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<RK_PawnKind_Noble>3</RK_PawnKind_Noble>
					<RK_PawnKind_Colonist>6</RK_PawnKind_Colonist>
					<RK_PawnKind_Servant>8</RK_PawnKind_Servant>
					<RK_PawnKind_Combatant>5</RK_PawnKind_Combatant>
					<RK_PawnKind_EliteGuardener>8</RK_PawnKind_EliteGuardener>
					<RK_PawnKind_Priest>3</RK_PawnKind_Priest>
				</options>
			</li>
		</pawnGroupMakers>
		<settlementTexturePath>Icon/RK_DefaultColony</settlementTexturePath>
		<apparelStuffFilter>
			<stuffCategoriesToAllow>
				<li>WeaponMetallic</li>
				<li>Fabric</li>
				<li>Leathery</li>
				<li>Woody</li>
			</stuffCategoriesToAllow>
		</apparelStuffFilter>
		<allowedCultures>
			<li>RatkiniaTraditionCulture</li>
		</allowedCultures>
	</FactionDef>
	<FactionDef ParentName="RK_FactionBase">
		<defName>Rakinia</defName>
		<label>ratkin kingdom</label>
		<description>랫킨 왕국입니다. 인간들 눈에 띄지 않도록 숨어서 살고 있으며 농경생활을 위주로 생활하는 비 침략적인 종족입니다.</description>
		<colorSpectrum>
			<li>(0.45, 0.50, 0.30)</li>
			<li>(0.65, 0.60, 0.20)</li>
		</colorSpectrum>
	</FactionDef>
</Defs>
