<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- RatHolic Gun 발사 속도 증가 버프 -->
  <HediffDef>
    <defName>RK_Hediff_RatHolicGunSpooling</defName>
    <label>spooling up</label>
    <description>The weapon is spooling up, reducing reload time with each shot fired.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <!-- 최대 Severity 1.0 = 5중첩 (코드에서 Severity로 중첩 처리: 0.2=1스택, 0.4=2스택, ..., 1.0=5스택) -->
    <maxSeverity>1</maxSeverity>
    <stages>
      <!-- Stage 1: 1스택 (Severity 0.2) -->
      <li>
        <minSeverity>0.2</minSeverity>
        <!-- UI에서 숨김 - 유저에게 드러나지 않음 -->
        <becomeVisible>false</becomeVisible>
        <statOffsets>
          <RK_Stat_RangeCoolDown>-0.3</RK_Stat_RangeCoolDown>
        </statOffsets>
      </li>
      <!-- Stage 2: 2스택 (Severity 0.4) -->
      <li>
        <minSeverity>0.4</minSeverity>
        <becomeVisible>false</becomeVisible>
        <statOffsets>
          <RK_Stat_RangeCoolDown>-0.6</RK_Stat_RangeCoolDown>
        </statOffsets>
      </li>
      <!-- Stage 3: 3스택 (Severity 0.6) -->
      <li>
        <minSeverity>0.6</minSeverity>
        <becomeVisible>false</becomeVisible>
        <statOffsets>
          <RK_Stat_RangeCoolDown>-0.9</RK_Stat_RangeCoolDown>
        </statOffsets>
      </li>
      <!-- Stage 4: 4스택 (Severity 0.8) -->
      <li>
        <minSeverity>0.8</minSeverity>
        <becomeVisible>false</becomeVisible>
        <statOffsets>
          <RK_Stat_RangeCoolDown>-1.2</RK_Stat_RangeCoolDown>
        </statOffsets>
      </li>
      <!-- Stage 5: 5스택 (Severity 1.0) -->
      <li>
        <minSeverity>1.0</minSeverity>
        <becomeVisible>false</becomeVisible>
        <statOffsets>
          <RK_Stat_RangeCoolDown>-1.5</RK_Stat_RangeCoolDown>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>

