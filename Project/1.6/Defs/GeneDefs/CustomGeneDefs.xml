	<!-- TODO: 독성 레지스턴스 웨이스터나 이타킨등 기존거 재활용 이용-->
	<GeneDef>
		<defName>RK_Gene_ToxicEnvironmentResistance_Mild</defName>
		<label>mild antitoxic lungs</label>
		<labelShortAdj>tox-adapted</labelShortAdj>
		<description>Carriers of this gene have adapted to toxic sewer environments and are slightly resistant to environmental toxins. They get less toxic buildup from tox gas, polluted terrain, and toxic fallout.</description>
		<iconPath>UI/Icons/Genes/Gene_PartialPollutionResistance</iconPath>
		<displayCategory>ResistanceAndWeakness</displayCategory>
		<displayOrderInCategory>15</displayOrderInCategory>
		<statOffsets>
			<ToxicEnvironmentResistance>0.35</ToxicEnvironmentResistance>
		</statOffsets>
		<biostatMet>-1</biostatMet>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>ToxicEnvironmentResistance</li>
		</exclusionTags>
	</GeneDef>

	<!-- 전투 특성 -->
	<!-- TODO: 재빠름은 있지만 없어서 추가. 그리고 어중간한 회피율이라 가벼운 몸과 추가 -->
	<GeneDef>
		<defName>RK_Gene_Nimble</defName>
		<label>nimble</label>
		<labelShortAdj>nimble</labelShortAdj>
		<description>Carriers of this gene have heightened sensory receptor sensitivity, allowing them to better detect nearby threats and evade close-range attacks more effectively.</description>
		<iconPath>UI/Icons/Genes/Gene_MoveSpeed_Quick</iconPath>
		<displayCategory>Violence</displayCategory>
		<displayOrderInCategory>45</displayOrderInCategory>
		<statOffsets>
			<MeleeDodgeChance>0.25</MeleeDodgeChance>
		</statOffsets>
		<biostatMet>-1</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- 근시 특성 -->
	<GeneDef>
		<defName>RK_Gene_PoorEyesight</defName>
		<label>poor eyesight</label>
		<labelShortAdj>poor eyesight</labelShortAdj>
		<description>Carriers of this gene have difficulty with precision aiming, resulting in slower aim time and research speed.</description>
		<iconPath>UI/Icons/Genes/Gene_Nearsighted</iconPath>
		<displayCategory>Violence</displayCategory>
		<displayOrderInCategory>55</displayOrderInCategory>
		<statFactors>
			<AimingDelayFactor>1.15</AimingDelayFactor>
			<ResearchSpeed>0.8</ResearchSpeed>

		</statFactors>
		<biostatMet>2</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

	<!-- 약함 특성 -->
	<GeneDef>
		<defName>RK_Gene_FragilePain</defName>
		<label>fragile pain threshold</label>
		<labelShortAdj>fragile</labelShortAdj>
		<description>Carriers of this gene have a lower pain shock threshold and go down more easily from injuries.</description>
		<iconPath>UI/Icons/Genes/Gene_ExtraPain</iconPath>
		<displayCategory>Pain</displayCategory>
		<displayOrderInCategory>25</displayOrderInCategory>
		<statOffsets>
			<PainShockThreshold>-0.1</PainShockThreshold>
			<CarryingCapacity>-15</CarryingCapacity>
		</statOffsets>
		<biostatMet>2</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

	<!-- 귀여운 외모 -->
	<GeneDef>
		<defName>RK_Gene_Adorable</defName>
		<label>adorable</label>
		<labelShortAdj>adorable</labelShortAdj>
		<description>Carriers of this gene have an irresistibly cute appearance. People find them endearing and enjoy their company, but tend to underestimate them in serious negotiations and business deals.</description>
		<iconPath>UI/Icons/Genes/Gene_Beautiful</iconPath>
		<displayCategory>Social</displayCategory>
		<displayOrderInCategory>102</displayOrderInCategory>
		<statFactors>
			<NegotiationAbility>0.80</NegotiationAbility>
			<TradePriceImprovement>0.90</TradePriceImprovement>
			<SocialImpact>1.20</SocialImpact>
		</statFactors>
		<biostatMet>0</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

	<!-- 작업 능력 -->

	<GeneDef>
		<defName>RK_Gene_EfficientMiner</defName>
		<label>efficient miner</label>
		<labelShortAdj>miner</labelShortAdj>
		<description>Carriers of this gene have an innate talent for digging and mining, working faster and extracting more resources.</description>
		<iconPath>UI/Icons/Genes/Gene_StrongMeleeDamage</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>103</displayOrderInCategory>
		<statFactors>
			<MiningSpeed>1.10</MiningSpeed>
			<MiningYield>1.10</MiningYield>
		</statFactors>
		<biostatMet>-1</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<GeneDef>
		<defName>RK_Gene_GreenThumb</defName>
		<label>plant affinity</label>
		<labelShortAdj>green thumb</labelShortAdj>
		<description>Carriers of this gene work more efficiently with plants.</description>
		<iconPath>UI/Icons/Genes/Gene_PsychicAbility_Enhanced</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>104</displayOrderInCategory>
		<statFactors>
			<PlantWorkSpeed>1.1</PlantWorkSpeed>
			<PlantYield>1.1</PlantYield>
		</statFactors>
		<biostatMet>-1</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

	<!-- 지적 능력 -->
	<GeneDef>
		<defName>RK_Gene_ClumsyBuilder</defName>
		<label>clumsy builder</label>
		<labelShortAdj>clumsy</labelShortAdj>
		<description>Carriers of this gene are not naturally gifted at construction work.</description>
		<iconPath>UI/Icons/Genes/Gene_SlowLearning</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>106</displayOrderInCategory>
		<statFactors>
			<ConstructionSpeed>0.9</ConstructionSpeed>
		</statFactors>
		<biostatMet>1</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>
</Defs>
