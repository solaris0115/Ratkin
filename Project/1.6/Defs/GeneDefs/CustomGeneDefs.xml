<Defs>

	<!-- ========================================
	     Ratkin Custom Genes
	     ======================================== -->

	<!-- TODO: 가벼운 체형, 회피율을 같이 준다. 무게가 가볍도록. -->
	<GeneDef>
		<defName>RK_Gene_SmallBody</defName>
		<label>small build</label>
		<labelShortAdj>small</labelShortAdj>
		<description>Carriers of this gene have a small, compact build with reduced body mass. This smaller frame makes them lighter and more agile, but limits their carrying capacity.</description>
		<iconPath>UI/Icons/Genes/Gene_BodyThin</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>100</displayOrderInCategory>
		<statOffsets>
			<Mass>-10</Mass>
			<CarryingCapacity>-15</CarryingCapacity>
			<MeleeDodgeChance>0.15</MeleeDodgeChance>
		</statOffsets>
		<biostatMet>1</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

	<!-- 환경 적응 -->
	<!-- TODO: 기존 추위 견딜 수 있는걸로,  -->
	<GeneDef>
		<defName>RK_Gene_MildColdTolerance</defName>
		<label>mild cold tolerance</label>
		<labelShortAdj>cool-adapted</labelShortAdj>
		<description>Carriers of this gene are slightly more comfortable in cold temperatures.</description>
		<iconPath>UI/Icons/Genes/Gene_MinTemperatureSmallDecrease</iconPath>
		<displayCategory>Temperature</displayCategory>
		<displayOrderInCategory>15</displayOrderInCategory>
		<statOffsets>
			<ComfyTemperatureMin>-5</ComfyTemperatureMin>
		</statOffsets>
		<biostatMet>-1</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

	<!-- TODO: 독성 레지스턴스 웨이스터나 이타킨등 기존거 재활용 이용-->
	<GeneDef>
		<defName>RK_Gene_ToxicEnvironmentResistance_Mild</defName>
		<label>mild antitoxic lungs</label>
		<labelShortAdj>tox-adapted</labelShortAdj>
		<description>Carriers of this gene have adapted to toxic sewer environments and are slightly resistant to environmental toxins. They get less toxic buildup from tox gas, polluted terrain, and toxic fallout.</description>
		<iconPath>UI/Icons/Genes/Gene_PartialPollutionResistance</iconPath>
		<displayCategory>ResistanceAndWeakness</displayCategory>
		<displayOrderInCategory>15</displayOrderInCategory>
		<statOffsets>
			<ToxicEnvironmentResistance>0.35</ToxicEnvironmentResistance>
		</statOffsets>
		<biostatMet>-1</biostatMet>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>ToxicEnvironmentResistance</li>
		</exclusionTags>
	</GeneDef>

