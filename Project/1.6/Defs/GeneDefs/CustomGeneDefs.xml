	<!-- TODO: 독성 레지스턴스 웨이스터나 이타킨등 기존거 재활용 이용-->
	<GeneDef>
		<defName>RK_Gene_ToxicEnvironmentResistance_Mild</defName>
		<label>mild antitoxic lungs</label>
		<labelShortAdj>tox-adapted</labelShortAdj>
		<description>Carriers of this gene have adapted to toxic sewer environments and are slightly resistant to environmental toxins. They get less toxic buildup from tox gas, polluted terrain, and toxic fallout.</description>
		<iconPath>UI/Icons/Genes/Gene_PartialPollutionResistance</iconPath>
		<displayCategory>ResistanceAndWeakness</displayCategory>
		<displayOrderInCategory>15</displayOrderInCategory>
		<statOffsets>
			<ToxicEnvironmentResistance>0.35</ToxicEnvironmentResistance>
		</statOffsets>
		<biostatMet>-1</biostatMet>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>ToxicEnvironmentResistance</li>
		</exclusionTags>
	</GeneDef>

	<!-- 전투 특성 -->
	<!-- TODO: 재빠름은 있지만 없어서 추가. 그리고 어중간한 회피율이라 가벼운 몸과 추가 -->
	<GeneDef>
		<defName>RK_Gene_Nimble</defName>
		<label>nimble</label>
		<labelShortAdj>nimble</labelShortAdj>
		<description>Carriers of this gene have heightened sensory receptor sensitivity, allowing them to better detect nearby threats and evade close-range attacks more effectively.</description>
		<iconPath>UI/Icons/Genes/Gene_MoveSpeed_Quick</iconPath>
		<displayCategory>Violence</displayCategory>
		<displayOrderInCategory>45</displayOrderInCategory>
		<statOffsets>
			<MeleeCooldownFactor>-0.1</MeleeCooldownFactor>
		</statOffsets>
		<statFactors>
			<MeleeDodgeChance>0.85</MeleeDodgeChance>
		</statFactors>
		<biostatMet>-2</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- 근시 특성 -->
	<GeneDef>
		<defName>RK_Gene_PoorEyesight</defName>
		<label>poor eyesight</label>
		<labelShortAdj>poor eyesight</labelShortAdj>
		<description>Carriers of this gene have difficulty with precision aiming, resulting in slower aim time and research speed.</description>
		<iconPath>UI/Icons/Genes/Gene_Nearsighted</iconPath>
		<displayCategory>Violence</displayCategory>
		<displayOrderInCategory>55</displayOrderInCategory>
		<statFactors>
			<AimingDelayFactor>1.15</AimingDelayFactor>
			<ShootingAccuracyPawn>0.9</ShootingAccuracyPawn>
		</statFactors>
		<biostatMet>2</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- 약함 특성 -->
	<GeneDef>
		<defName>RK_Gene_FragilePain</defName>
		<label>fragile pain threshold</label>
		<labelShortAdj>fragile</labelShortAdj>
		<description>Carriers of this gene have a lower pain shock threshold and go down more easily from injuries.</description>
		<iconPath>UI/Icons/Genes/Gene_ExtraPain</iconPath>
		<displayCategory>Pain</displayCategory>
		<displayOrderInCategory>25</displayOrderInCategory>
		<statOffsets>
			<PainShockThreshold>-0.1</PainShockThreshold>
			<CarryingCapacity>-15</CarryingCapacity>
		</statOffsets>
		<biostatMet>2</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- 귀여운 외모 -->
	<GeneDef>
		<defName>RK_Gene_Adorable</defName>
		<label>adorable</label>
		<labelShortAdj>adorable</labelShortAdj>
		<description>Carriers of this gene have an irresistibly cute appearance. People find them endearing and enjoy their company, but tend to underestimate them in serious negotiations and business deals.</description>
		<iconPath>UI/Icons/Genes/Gene_Beautiful</iconPath>
		<displayCategory>Social</displayCategory>
		<displayOrderInCategory>102</displayOrderInCategory>
		<statFactors>
			<NegotiationAbility>0.80</NegotiationAbility>
			<TradePriceImprovement>0.90</TradePriceImprovement>
			<SocialImpact>1.20</SocialImpact>
		</statFactors>
		<biostatMet>0</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<!-- 작업 능력 -->

	<GeneDef>
		<defName>RK_Gene_EfficientMiner</defName>
		<label>efficient miner</label>
		<labelShortAdj>miner</labelShortAdj>
		<description>Carriers of this gene have an innate talent for digging and mining, working faster and extracting more resources.</description>
		<iconPath>UI/Icons/Genes/Gene_StrongMeleeDamage</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>103</displayOrderInCategory>
		<statFactors>
			<MiningSpeed>0.9</MiningSpeed>
			<MiningYield>1.10</MiningYield>
		</statFactors>
		<biostatMet>-1</biostatMet>
		<biostatCpx>1</biostatCpx>
	</GeneDef>

	<GeneDef>
		<defName>RK_Gene_GreenThumb</defName>
		<label>plant affinity</label>
		<labelShortAdj>green thumb</labelShortAdj>
		<description>Carriers of this gene work more efficiently with plants.</description>
		<iconPath>UI/Icons/Genes/Gene_PsychicAbility_Enhanced</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>104</displayOrderInCategory>
		<statFactors>
			<PlantWorkSpeed>0.9</PlantWorkSpeed>
			<PlantYield>1.1</PlantYield>
		</statFactors>
		<biostatMet>-1</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

	<!-- 지적 능력 -->
	<GeneDef>
		<defName>RK_Gene_ClumsyBuilder</defName>
		<label>clumsy builder</label>
		<labelShortAdj>clumsy</labelShortAdj>
		<description>Carriers of this gene are not naturally gifted at construction work.</description>
		<iconPath>UI/Icons/Genes/Gene_SlowLearning</iconPath>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>106</displayOrderInCategory>
		<statFactors>
			<ConstructionSpeed>0.9</ConstructionSpeed>
		</statFactors>
		<biostatMet>1</biostatMet>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

	<!-- ========================================
	     Ratkin Appearance Genes
	     ======================================== -->

	<!-- 큰 귀 -->
	<GeneDef>
		<defName>RK_Gene_LargeEars</defName>
		<label>large round ears</label>
		<labelShortAdj>big-eared</labelShortAdj>
		<description>Carriers of this gene have distinctively large, round ears that give them enhanced hearing and an unmistakably ratkin appearance.</description>
		<iconPath>UI/Icons/Genes/Gene_EarCat</iconPath>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<displayCategory>Cosmetic</displayCategory>
		<displayOrderInCategory>70</displayOrderInCategory>
		<randomChosen>true</randomChosen>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>Ears</li>
		</exclusionTags>
		<renderNodeProperties>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPath>Things/Pawn/Humanlike/HeadAttachments/RatkinEars/RatkinEars</texPath>
				<colorType>Skin</colorType>
				<parentTagDef>Head</parentTagDef>
				<useSkinShader>true</useSkinShader>
				<useRottenColor>true</useRottenColor>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<drawData>
					<defaultData>
						<layer>70</layer>
					</defaultData>
				</drawData>
			</li>
		</renderNodeProperties>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>rat</symbol></li>
				<li><symbol>squeak</symbol></li>
				<li><symbol>whisk</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
				<li><symbol>rat</symbol></li>
				<li><symbol>ear</symbol></li>
				<li><symbol>squeak</symbol></li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

	<!-- 얇은 꼬리 -->
	<GeneDef>
		<defName>RK_Gene_ThinTail</defName>
		<label>thin tail</label>
		<labelShortAdj>thin-tailed</labelShortAdj>
		<description>Carriers of this gene have a long, thin, hairless tail that helps with balance and is a signature feature of ratkin anatomy.</description>
		<iconPath>UI/Icons/Genes/Gene_TailSmooth</iconPath>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<displayCategory>Miscellaneous</displayCategory>
		<displayOrderInCategory>1000</displayOrderInCategory>
		<randomChosen>true</randomChosen>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>Tail</li>
		</exclusionTags>
		<renderNodeProperties>
			<li>
				<workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
				<texPath>Things/Pawn/Humanlike/BodyAttachments/RatkinTail/RatkinTail</texPath>
				<colorType>Skin</colorType>
				<overrideMeshSize>(1, 1)</overrideMeshSize>
				<parentTagDef>Body</parentTagDef>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<drawData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<defaultData>
						<layer>-2</layer>
					</defaultData>
					<dataNorth>
						<offset>(0, 0, -0.15)</offset>
						<layer>90</layer>
					</dataNorth>
					<dataSouth>
						<offset>(-0, 0, -0.15)</offset>
					</dataSouth>
					<dataEast>
						<offset>(-0.5, 0, -0.15)</offset>
					</dataEast>
					<dataWest>
						<offset>(0.5, 0, -0.15)</offset>
					</dataWest>
				</drawData>
			</li>
		</renderNodeProperties>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>tail</symbol></li>
				<li><symbol>rat</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
				<li><symbol>tail</symbol></li>
				<li><symbol>rat</symbol></li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

	<!-- 귀여운 얼굴 -->
	<GeneDef>
		<defName>RK_Gene_CuteFace</defName>
		<label>cute face</label>
		<labelShortAdj>cute-faced</labelShortAdj>
		<description>Carriers of this gene have an adorable facial structure with rounded features, button nose, and expressive eyes that make them appear endearing and approachable.</description>
		<iconPath>UI/Icons/Genes/Gene_Beautiful</iconPath>
		<displayCategory>Cosmetic</displayCategory>
		<displayOrderInCategory>50</displayOrderInCategory>
		<selectionWeight>5.0</selectionWeight>
		<exclusionTags>
			<li>FaceType</li>
		</exclusionTags>
		<forcedHeadTypes>
			<li>RK_HeadType_Head1</li>
			<li>RK_HeadType_Head2</li>
			<li>RK_HeadType_Head3</li>
			<li>RK_HeadType_Head4</li>
			<li>RK_HeadType_Head5</li>
			<li>RK_HeadType_Head6</li>
			<li>RK_HeadType_Head7</li>
			<li>RK_HeadType_Head8</li>
		</forcedHeadTypes>
		<statOffsets>
			<!-- <PawnBeauty>1</PawnBeauty> -->
		</statOffsets>
		<biostatMet>0</biostatMet>
		<biostatCpx>0</biostatCpx>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>cute</symbol></li>
				<li><symbol>sweet</symbol></li>
				<li><symbol>charm</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
				<li><symbol>charm</symbol></li>
				<li><symbol>cute</symbol></li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

	
</Defs>
