<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="ArtableFurnitureBase">
    <defName>RK_Pulpit</defName>
    <label>pulpit</label>
    <description>a small pulpit. ratkin priest can host prayer meeting in this place.</description>
    <graphicData>
      <texPath>Things/Building/Furniture/RK_Pulpit</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5, 1.5)</drawSize>
    </graphicData>
    <costStuffCount>60</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>400</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>10</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <designationCategory>Furniture</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <buildingTags>
        <li>BuildingsFurniture</li>
      </buildingTags>
    </building>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <!-- 벽 부착형. WallLamp 구조 기반 — 이후 미술품(CompArt) 전환 예정 -->
  <ThingDef ParentName="LampBase">
    <defName>RK_Thing_Paint</defName>
    <label>paint</label>
    <description>A wall-mounted lamp. Lights an area using electricity. Based on the wall lamp structure for future conversion into wall art.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/Furniture/WallLamp/WallLamp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Furniture/WallLamp/WallLamp_MenuIcon</uiIconPath>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <costList>
      <Steel>15</Steel>
    </costList>
    <statBases>
      <WorkToBuild>330</WorkToBuild>
      <MaxHitPoints>35</MaxHitPoints>
      <Mass>2</Mass>
    </statBases>
    <uiOrder>2991</uiOrder>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <overrideMinifiedRot>North</overrideMinifiedRot>
    <minifiedDrawOffset>(0, 0, 0.2)</minifiedDrawOffset>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
    </building>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>30</basePowerConsumption>
        <powerUpgrades>
          <li>
            <researchProject>ColoredLights</researchProject>
            <factor>0.5</factor>
          </li>
        </powerUpgrades>
      </li>
      <li Class="CompProperties_Styleable" />
      <li Class="CompProperties_Glower">
        <glowRadius>11</glowRadius>
        <glowColor>(214,148,94,0)</glowColor>
        <colorPickerEnabled>true</colorPickerEnabled>
        <darklightToggle>true</darklightToggle>
      </li>
    </comps>
  </ThingDef>
</Defs>