<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="ArtableFurnitureBase">
    <defName>RK_Pulpit</defName>
    <label>pulpit</label>
    <description>a small pulpit. ratkin priest can host prayer meeting in this place.</description>
    <graphicData>
      <texPath>Things/Building/Furniture/RK_Pulpit</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5, 1.5)</drawSize>
    </graphicData>
    <costStuffCount>60</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>400</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>10</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <designationCategory>Furniture</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <buildingTags>
        <li>BuildingsFurniture</li>
      </buildingTags>
    </building>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <!-- Wall-mounted unique painting. Not buildable; spawned/minified art only. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RK_Thing_Paint</defName>
    <thingClass>Building_Art</thingClass>
    <label>wall painting</label>
    <description>A wall-mounted painting. Each piece bears a unique image.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/Art/RK_Texture_PictureUnique</texPath>
      <graphicClass>NewRatkin.Graphic_RKPictureUniqueRandom</graphicClass>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Art/RK_Texture_PictureUnique</uiIconPath>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToBuild>100</WorkToBuild>
      <MaxHitPoints>35</MaxHitPoints>
      <Mass>2</Mass>
      <Beauty>40</Beauty>
      <Flammability>1.0</Flammability>
      <SellPriceFactor>1.10</SellPriceFactor>
    </statBases>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <overrideMinifiedRot>North</overrideMinifiedRot>
    <minifiedDrawOffset>(0, 0, 0.2)</minifiedDrawOffset>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
    </building>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Styleable" />
      <li Class="NewRatkin.CompProperties_RKRandomGraphicIndex" />
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtSculpture</nameMaker>
        <descriptionMaker>ArtDescription_Sculpture</descriptionMaker>
        <canBeEnjoyedAsArt>true</canBeEnjoyedAsArt>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Art</li>
    </inspectorTabs>
    <tradeTags>
      <li>Art</li>
    </tradeTags>
  </ThingDef>
</Defs>
