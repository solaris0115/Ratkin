<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ═══════════════════════════════════════════════════════════
		 방패 블록 찬스 (ShieldBlockChance) — Pawn 스탯 (1단계 게이트)
		 MeleeHitChance와 동일 구조: 근접 스킬 + 조작 + 시야 → 0~1.
		 이 값으로 블락 시도 성공 여부만 판정. 아머와 무관.
		 성공 시 2단계: RK_Stat_Shield_Sharp/Blunt/Heat vs AP 아머 롤.
	     ═══════════════════════════════════════════════════════════ -->
	<StatDef>
		<defName>RK_Stat_ShieldBlockChance</defName>
		<label>shield block chance</label>
		<description>Chance to attempt blocking an incoming attack with this shield.\n\nIf the attempt succeeds, a second armor roll (shield armor vs attacker AP) determines whether the attack is fully deflected.\n\nAffected by melee skill, manipulation, and sight — identical modifiers to melee hit chance.</description>
		<workerClass>NewRatkin.StatWorker_ShieldBlockChance</workerClass>
		<category>PawnCombat</category>
		<defaultBaseValue>0</defaultBaseValue>
		<minValue>0</minValue>
		<maxValue>1</maxValue>
		<hideAtValue>0</hideAtValue>
		<toStringStyle>PercentOne</toStringStyle>
		<showIfUndefined>false</showIfUndefined>
		<noSkillOffset>4</noSkillOffset>
		<skillNeedOffsets>
			<li Class="SkillNeed_BaseBonus">
				<skill>Melee</skill>
				<baseValue>0</baseValue>
				<bonusPerLevel>1</bonusPerLevel>
			</li>
		</skillNeedOffsets>
		<capacityOffsets>
			<li>
				<capacity>Manipulation</capacity>
				<scale>12</scale>
				<max>1.5</max>
			</li>
			<li>
				<capacity>Sight</capacity>
				<scale>12</scale>
				<max>1.5</max>
			</li>
		</capacityOffsets>
		<postProcessCurve>
			<points>
				<li>(-20, 0.05)</li>
				<li>(-10, 0.10)</li>
				<li>(0.0, 0.50)</li>
				<li>(10, 0.80)</li>
				<li>(20, 0.90)</li>
				<li>(40, 0.96)</li>
				<li>(60, 0.98)</li>
			</points>
		</postProcessCurve>
		<displayPriorityInCategory>1410</displayPriorityInCategory>
	</StatDef>


	<!-- ═══════════════════════════════════════════════════════════
		 방패 각도 (DeflectAngle) — Pawn 스탯
		 방패는 equippedStatOffsets으로 풀각(도)을 제공.
		 근접 스킬이 offset으로 영향을 주며, postProcessCurve로 로그형 감소 적용.
		 내부 판정(ApparelShieldTowerSecond)은 /2 하여 반각 사용.
	     ═══════════════════════════════════════════════════════════ -->
	<StatDef>
		<defName>RK_Stat_DeflectAngle</defName>
		<label>shield deflect angle</label>
		<description>The total frontal arc (in degrees) within which this shield can deflect incoming attacks. For example, 90° means ±45° to each side.\n\nAffected by melee skill: low skill reduces the arc, high skill widens it (with diminishing returns).</description>
		<workerClass>NewRatkin.StatWorker_ShieldDeflectAngle</workerClass>
		<category>PawnCombat</category>
		<defaultBaseValue>0</defaultBaseValue>
		<minValue>0</minValue>
		<hideAtValue>0</hideAtValue>
		<toStringStyle>FloatOne</toStringStyle>
		<formatString>{0}°</formatString>
		<showIfUndefined>false</showIfUndefined>
		<skillNeedOffsets>
			<li Class="SkillNeed_BaseBonus">
				<skill>Melee</skill>
				<baseValue>-40</baseValue>
				<bonusPerLevel>4</bonusPerLevel>
			</li>
		</skillNeedOffsets>
		<postProcessCurve>
			<points>
				<li>(0, 0)</li>
				<li>(50, 48)</li>
				<li>(90, 90)</li>
				<li>(140, 138)</li>
				<li>(180, 162)</li>
				<li>(220, 180)</li>
			</points>
		</postProcessCurve>
		<displayPriorityInCategory>1400</displayPriorityInCategory>
	</StatDef>


	<!-- ═══════════════════════════════════════════════════════════
		 방패 전용 방어력 (Shield Armor)
		 바닐라 StuffEffectMultiplierArmor + ArmorRating 3종의 방패 전용 버전.
		 방패별로 독립적으로 stuff 배율·품질 계수·기본 방어력을 튜닝 가능.
	     ═══════════════════════════════════════════════════════════ -->

	<!-- 방패 stuff 배율 (hidden) — 바닐라 StuffEffectMultiplierArmor 대응 -->
	<StatDef>
		<defName>RK_Stat_ShieldStuffBase</defName>
		<label>Shield Armor - Material effect multiplier</label>
		<category>Apparel</category>
		<defaultBaseValue>0</defaultBaseValue>
		<minValue>0</minValue>
		<alwaysHide>true</alwaysHide>
		<displayPriorityInCategory>83</displayPriorityInCategory>
	</StatDef>

	<!-- 방패 방어력 공통 부모 (Abstract) -->
	<StatDef Name="RK_ShieldArmorBase" Abstract="True">
		<category>Apparel</category>
		<defaultBaseValue>0</defaultBaseValue>
		<minValue>0</minValue>
		<hideAtValue>0</hideAtValue>
		<maxValue>2</maxValue>
		<toStringStyle>PercentOne</toStringStyle>
		<parts>
			<li Class="StatPart_Quality">
				<factorAwful>0.70</factorAwful>
				<factorPoor>0.85</factorPoor>
				<factorNormal>1.00</factorNormal>
				<factorGood>1.10</factorGood>
				<factorExcellent>1.20</factorExcellent>
				<factorMasterwork>1.35</factorMasterwork>
				<factorLegendary>1.60</factorLegendary>
			</li>
		</parts>
	</StatDef>

	<!-- 방패 방어도 - 날카로움 -->
	<StatDef ParentName="RK_ShieldArmorBase">
		<defName>RK_Stat_Shield_Sharp</defName>
		<label>Shield Armor - Sharp</label>
		<description>Shield protection against sharp damage like bullets, knife stabs, and animal bites.\n\nUsed in the shield deflect formula: higher values increase block chance against sharp attacks.</description>
		<displayPriorityInCategory>87</displayPriorityInCategory>
		<parts>
			<li Class="StatPart_Stuff">
				<priority>100</priority>
				<stuffPowerStat>StuffPower_Armor_Sharp</stuffPowerStat>
				<multiplierStat>RK_Stat_ShieldStuffBase</multiplierStat>
			</li>
		</parts>
	</StatDef>

	<!-- 방패 방어도 - 둔탁함 -->
	<StatDef ParentName="RK_ShieldArmorBase">
		<defName>RK_Stat_Shield_Blunt</defName>
		<label>Shield Armor - Blunt</label>
		<description>Shield protection against blunt damage like fists, club impacts and rock falls.\n\nUsed in the shield deflect formula: higher values increase block chance against blunt attacks.</description>
		<displayPriorityInCategory>86</displayPriorityInCategory>
		<parts>
			<li Class="StatPart_Stuff">
				<priority>100</priority>
				<stuffPowerStat>StuffPower_Armor_Blunt</stuffPowerStat>
				<multiplierStat>RK_Stat_ShieldStuffBase</multiplierStat>
			</li>
		</parts>
	</StatDef>

	<!-- 방패 방어도 - 열기 -->
	<StatDef ParentName="RK_ShieldArmorBase">
		<defName>RK_Stat_Shield_Heat</defName>
		<label>Shield Armor - Heat</label>
		<description>Shield protection against temperature-related damage like burns.\n\nUsed in the shield deflect formula: higher values increase block chance against heat attacks.</description>
		<displayPriorityInCategory>85</displayPriorityInCategory>
		<parts>
			<li Class="StatPart_Stuff">
				<priority>100</priority>
				<stuffPowerStat>StuffPower_Armor_Heat</stuffPowerStat>
				<multiplierStat>RK_Stat_ShieldStuffBase</multiplierStat>
			</li>
		</parts>
	</StatDef>

</Defs>
