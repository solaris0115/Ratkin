<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 타워실드 등 정면 도탄: 입사 허용 각도(좌우 반각, 도). 품질 계수 0.7(형편없음)~1.3(전설). -->
	<StatDef>
		<defName>RK_Stat_DeflectAngle</defName>
		<label>Shield deflect angle</label>
		<labelForFullStatList>Shield deflect arc (half-angle, deg)</labelForFullStatList>
		<description>When drafted, ranged attacks from within this angle (left and right of facing) can be deflected by the shield. Higher quality widens the arc.</description>
		<category>Apparel</category>
		<defaultBaseValue>45</defaultBaseValue>
		<minValue>0</minValue>
		<maxValue>180</maxValue>
		<toStringStyle>FloatOne</toStringStyle>
		<formatString>{0}°</formatString>
		<showIfUndefined>false</showIfUndefined>
		<displayPriorityInCategory>66</displayPriorityInCategory>
		<parts>
			<li Class="StatPart_Quality">
				<factorAwful>0.7</factorAwful>
				<factorPoor>0.8</factorPoor>
				<factorNormal>1.0</factorNormal>
				<factorGood>1.05</factorGood>
				<factorExcellent>1.1</factorExcellent>
				<factorMasterwork>1.2</factorMasterwork>
				<factorLegendary>1.3</factorLegendary>
			</li>
		</parts>
	</StatDef>
</Defs>
