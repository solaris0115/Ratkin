<?xml version="1.0" encoding="utf-8" ?>
<Defs> 

	<!-- 시민 -->
	<!-- 귀족 -->
	<!-- 하인 -->
	<!-- 사제 -->
	<!-- 농부 -->
	<!-- 노예 -->

	<!-- 평화 -->
	<!-- 시민 -->
	<PawnKindDef ParentName="RK_PawnKindAttr_NoneFighter">
		<defName>RK_PawnKind_Colonist</defName>
		<label>ratkin colonist</label>
		<defaultFactionType>RK_PlayerFaction</defaultFactionType>		
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>RK_BackstoryCategory_All</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<apparelRequired>
			<li>RK_ThingApparel_Basic</li>
		</apparelRequired>
		<apparelMoney>
			<min>120</min>
			<max>120</max>
		</apparelMoney>
		<apparelTags>
			<li>RK_ApparelTag_Farmer</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0.0</apparelAllowHeadgearChance>
		<apparelColor>(254,254,254)</apparelColor>
	</PawnKindDef>
	
	<!-- 귀족 -->
	<PawnKindDef ParentName="RK_PawnKindAttr_NoneFighter">
		<defName>RK_PawnKind_Noble</defName>
		<label>ratkin noble</label>
		<combatPower>35</combatPower>

		<factionLeader>true</factionLeader>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>RK_BackstoryCategory_Noble</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<itemQuality>Good</itemQuality>
		<apparelMoney>
			<min>800</min>
			<max>3500</max>
		</apparelMoney>
		<apparelTags>
			<li>RK_ApparelTag_Noble</li>
		</apparelTags>
		<apparelAllowHeadgearChance>0.3</apparelAllowHeadgearChance>
		<inventoryOptions>
			<skipChance>0.5</skipChance>
			<subOptionsChooseOne>
				<li>
					<choiceChance>95</choiceChance>
					<thingDef>Silver</thingDef>
					<countRange>
						<min>500</min>
						<max>800</max>
					</countRange>
				</li>
				<li>
					<choiceChance>5</choiceChance>
					<thingDef>Silver</thingDef>
					<countRange>
						<min>1000</min>
						<max>3500</max>
					</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>
		<trader>true</trader>
	</PawnKindDef>

	<!-- 하인 -->
	<PawnKindDef ParentName="RK_PawnKindAttr_NoneFighter">
		<defName>RK_PawnKind_Servant</defName>
		<label>ratkin servant</label>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>RK_BackstoryCategory_Servant</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<apparelMoney>
			<min>560</min>
			<max>2400</max>
		</apparelMoney>
		<apparelTags>
			<li>RK_ApparelTag_Apparel</li>
			<li>RK_ApparelTag_Servant</li>
		</apparelTags>
	</PawnKindDef>

	<!-- 랫킨 사제 -->
	<PawnKindDef ParentName="RK_PawnKindAttr_NoneFighter">
		<defName>RK_PawnKind_Priest</defName>
		<label>ratkin priest</label>
		<factionLeader>true</factionLeader>
		<minGenerationAge>21</minGenerationAge>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>RK_BackstoryCategory_Civilian</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<apparelMoney>
			<min>800</min>
			<max>2000</max>
		</apparelMoney>
		<apparelTags>
			<li>RK_ApparelTag_Priest</li>
		</apparelTags>
		<apparelRequired>
			<li>RK_ThingApparel_PriestVeil</li>
		</apparelRequired>		
	</PawnKindDef>
</Defs>
