<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Biotech xenoType 적용을 위해 RK_Race_Ratkin의 statBases 제거 -->
	<!-- xenoType에서 스탯을 정의하므로 ThingDef_AlienRace의 statBases는 더 이상 필요하지 않음 -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Ludeon.RimWorld.Biotech</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationRemove">
					<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RK_Race_Ratkin"]/statBases</xpath>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>