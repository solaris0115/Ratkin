<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Biotech: raceRestriction 장비 목록 제거 → GeneEquipRestriction(C#)으로 RK_Gene_SmallBody 필요 -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationRemove">
					<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Ratkin"]/alienRace/raceRestriction/apparelList/li</xpath>
				</li>
				<li Class="PatchOperationRemove">
					<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Ratkin"]/alienRace/raceRestriction/weaponList/li</xpath>
				</li>

				<!-- 의상·무기 추상 베이스 + RK_ApparelBase 미상속 Def -->
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_ApparelBase"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_MeleeWeapon"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_NeolithicRangeWeapon"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_IndustrialRangeWeapon"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_BaseArtilleryWeapon"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_ApparelAttr_CataphractArmorBase"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_ApparelAttr_CataphractHelmetBase"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[defName="RK_MagicWand"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[defName="RK_Apparel_VacsuitHelmet"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[defName="RK_Apparel_Vacsuit"]</xpath>
					<value>
						<li Class="NewRatkin.GeneEquipRestriction">
							<requiredGenes>
								<li>RK_Gene_SmallBody</li>
							</requiredGenes>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
