<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- 공용 Biotech: 무기의 종족 제한을 Thin 체형 제한으로 대체. 의상 변경은 1.7/Biotech에서만 적용. -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationRemove">
					<xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="Ratkin"]/alienRace/raceRestriction/weaponList/li</xpath>
				</li>

				<!-- 무기 추상 베이스와 개별 무기 -->
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_MeleeWeapon"]</xpath>
					<value>
						<li Class="NewRatkin.BodyTypeEquipRestriction">
							<allowedBodyTypes>
								<li>Thin</li>
							</allowedBodyTypes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_NeolithicRangeWeapon"]</xpath>
					<value>
						<li Class="NewRatkin.BodyTypeEquipRestriction">
							<allowedBodyTypes>
								<li>Thin</li>
							</allowedBodyTypes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_IndustrialRangeWeapon"]</xpath>
					<value>
						<li Class="NewRatkin.BodyTypeEquipRestriction">
							<allowedBodyTypes>
								<li>Thin</li>
							</allowedBodyTypes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[@Name="RK_BaseArtilleryWeapon"]</xpath>
					<value>
						<li Class="NewRatkin.BodyTypeEquipRestriction">
							<allowedBodyTypes>
								<li>Thin</li>
							</allowedBodyTypes>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>/Defs/ThingDef[defName="RK_MagicWand"]</xpath>
					<value>
						<li Class="NewRatkin.BodyTypeEquipRestriction">
							<allowedBodyTypes>
								<li>Thin</li>
							</allowedBodyTypes>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
