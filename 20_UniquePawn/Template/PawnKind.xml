<!--
	유니크 폰 PawnKindDef 템플릿
	{Name} 부분을 실제 이름으로 교체하여 사용
-->
<Defs>

	<PawnKindDef ParentName="RKBasePawnKind">
		<defName>RK_Unique_{Name}</defName>
		<label>{Name}, the {Title}</label>

		<!-- === 백스토리 고정 === -->
		<fixedChildBackstories>
			<li>RK_Unique_{Name}_Childhood</li>
		</fixedChildBackstories>
		<fixedAdultBackstories>
			<li>RK_Unique_{Name}_Adulthood</li>
		</fixedAdultBackstories>

		<!-- === 기본 === -->
		<fixedGender>Female</fixedGender>
		<!-- <minGenerationAge>20</minGenerationAge> -->
		<!-- <maxGenerationAge>45</maxGenerationAge> -->
		<combatPower>80</combatPower>
		<isFighter>true</isFighter>
		<canBeSapper>false</canBeSapper>
		<maxPerGroup>1</maxPerGroup>

		<!-- === 무기 === -->
		<weaponMoney>
			<min>400</min>
			<max>800</max>
		</weaponMoney>
		<weaponTags>
			<li>RK_MeleeWeapon</li>
		</weaponTags>
